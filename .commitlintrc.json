{
  "extends": [],
  "formatter": "default",
  "rules": {
    "type-enum": [2, "always", [
      "feat",
      "fix",
      "docs",
      "test",
      "refact",
      "refactor",
      "perf",
      "chore",
      "style",
      "ci",
      "build",
      "deps",
      "revert"
    ]],
    "type-case": [2, "always", "lower-case"],
    "type-empty": [2, "never"],
    "subject-case": [0, "always", "lower-case"],
    "subject-empty": [2, "never"],
    "subject-full-stop": [2, "never", "."],
    "header-max-length": [2, "always", 100]
  }
}